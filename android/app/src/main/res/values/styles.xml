<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tournixo.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/tournixo_bg</item>
        <item name="android:statusBarColor">@color/tournixo_bg</item>
        <item name="android:navigationBarColor">@color/tournixo_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/tournixo_accent</item>
        <item name="colorAccent">@color/tournixo_accent</item>
    </style>

    <style name="Theme.Tournixo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tournixo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Tournixo.NoActionBar</item>
    </style>
</resources>
